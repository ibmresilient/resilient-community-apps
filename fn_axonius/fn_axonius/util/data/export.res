      "last_modified_time": 1711056235114,
      "local_scripts": [
        {
          "actions": [],
          "created_date": 1710444246199,
          "description": "Write results of run enforcement set function to a note.",
          "enabled": false,
          "export_key": "Axonius: Write results of run enforcement set to note",
          "id": 34,
          "language": "python3",
          "last_modified_by": "admin@example.com",
          "last_modified_time": 1710444246199,
          "name": "Axonius: Write results of run enforcement set to note",
          "object_type": "incident",
          "playbook_handle": "axonius_run_enforcement_set",
          "programmatic_name": "axonius_run_enforcement_set_axonius_write_results_of_run_enforcement_set_to_note",
          "script_text": "results = playbook.functions.results.run_enforcement_set_results\n\nif results.get(\"success\", False):\n  content = results.get(\"content\", {})\n  \n  if content:\n    values = content.get(\"value\")\n    note_text = \"\"\n    for value in values:\n      enforcement_name = value.get(\"name\", None)\n      enforcement_id = value.get(\"id\", None)\n      new_text = f\"\u003cb\u003eAxonius: Run Enforcement by Name:\u003c/b\u003e ran Enforcement Name: \u003cb\u003e{enforcement_name}\u003c/b\u003e\u003cbr\u003e ID: {enforcement_id}\u003cbr\u003e\"\n      note_text = note_text + new_text\n  else:\n    note_text = f\"\u003cb\u003eAxonius: Run Enforcement by Name:\u003c/b\u003e did not run: no content\"\nelse:\n  note_text = \"\u003cb\u003eAxonius: Run Enforcement by Name:\u003c/b\u003e failed:\u003cbr\u003e {0}\".format(results.get(\"reason\", None))\nincident.addNote(note_text)",
          "tags": [],
          "uuid": "928ac8e5-06d0-4fdc-8543-8631a5955a68"
        }
      ],
