    {
      "activation_type": "manual",
      "content": {
        "content_version": 10,
        "xml": "\u003c?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"no\"?\u003e\u003cdefinitions xmlns=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:omgdc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:omgdi=\"http://www.omg.org/spec/DD/20100524/DI\" xmlns:resilient=\"http://resilient.ibm.com/bpmn\" xmlns:xsd=\"http://www.w3.org/2001/XMLSchema\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" targetNamespace=\"http://www.camunda.org/test\"\u003e\u003cprocess id=\"playbook_aa0570c8_7ba7_4e72_ab26_3fe7aeb9a6f2\" isExecutable=\"true\" name=\"playbook_aa0570c8_7ba7_4e72_ab26_3fe7aeb9a6f2\"\u003e\u003cdocumentation/\u003e\u003cstartEvent id=\"StartEvent_155asxm\"\u003e\u003coutgoing\u003eFlow_0z44zis\u003c/outgoing\u003e\u003c/startEvent\u003e\u003cserviceTask id=\"ServiceTask_1\" name=\"Axonius: Get Device By ID\" resilient:type=\"function\"\u003e\u003cextensionElements\u003e\u003cresilient:function uuid=\"8ff42f9c-c5ee-40c0-bf47-812cfad16bff\"\u003e{\"inputs\":{},\"pre_processing_script\":\"inputs.axonius_internal_axon_id = row.axonius_id\\ninputs.axonius_write_attachment = True\\ninputs.axonius_attachment_name = \\\"Axonius-Device-{0}.json\\\".format(row.axonius_name)\\ninputs.axonius_incident_id = incident.id\\ninputs.axonius_task_id = None\",\"pre_processing_script_language\":\"python3\",\"result_name\":\"get_device_results\"}\u003c/resilient:function\u003e\u003c/extensionElements\u003e\u003cincoming\u003eFlow_0z44zis\u003c/incoming\u003e\u003coutgoing\u003eFlow_1ocn8zg\u003c/outgoing\u003e\u003c/serviceTask\u003e\u003csequenceFlow id=\"Flow_0z44zis\" sourceRef=\"StartEvent_155asxm\" targetRef=\"ServiceTask_1\"/\u003e\u003cendEvent id=\"EndPoint_3\" resilient:documentation=\"End point\"\u003e\u003cincoming\u003eFlow_1013mmx\u003c/incoming\u003e\u003c/endEvent\u003e\u003cscriptTask id=\"ScriptTask_4\" name=\"Axonius: Write attachment creation results to a note\"\u003e\u003cextensionElements\u003e\u003cresilient:script uuid=\"bd87239d-b0bc-49b1-bcfa-62bcbc3ccea0\"/\u003e\u003c/extensionElements\u003e\u003cincoming\u003eFlow_1ocn8zg\u003c/incoming\u003e\u003coutgoing\u003eFlow_1013mmx\u003c/outgoing\u003e\u003cscript\u003escript\u003c/script\u003e\u003c/scriptTask\u003e\u003csequenceFlow id=\"Flow_1ocn8zg\" sourceRef=\"ServiceTask_1\" targetRef=\"ScriptTask_4\"/\u003e\u003csequenceFlow id=\"Flow_1013mmx\" sourceRef=\"ScriptTask_4\" targetRef=\"EndPoint_3\"/\u003e\u003c/process\u003e\u003cbpmndi:BPMNDiagram id=\"BPMNDiagram_1\"\u003e\u003cbpmndi:BPMNPlane bpmnElement=\"playbook_aa0570c8_7ba7_4e72_ab26_3fe7aeb9a6f2\" id=\"BPMNPlane_1\"\u003e\u003cbpmndi:BPMNEdge bpmnElement=\"Flow_1013mmx\" id=\"Flow_1013mmx_di\"\u003e\u003comgdi:waypoint x=\"727\" y=\"352\"/\u003e\u003comgdi:waypoint x=\"727\" y=\"424\"/\u003e\u003c/bpmndi:BPMNEdge\u003e\u003cbpmndi:BPMNEdge bpmnElement=\"Flow_1ocn8zg\" id=\"Flow_1ocn8zg_di\"\u003e\u003comgdi:waypoint x=\"727\" y=\"202\"/\u003e\u003comgdi:waypoint x=\"727\" y=\"268\"/\u003e\u003c/bpmndi:BPMNEdge\u003e\u003cbpmndi:BPMNEdge bpmnElement=\"Flow_0z44zis\" id=\"Flow_0z44zis_di\"\u003e\u003comgdi:waypoint x=\"727\" y=\"66\"/\u003e\u003comgdi:waypoint x=\"727\" y=\"118\"/\u003e\u003c/bpmndi:BPMNEdge\u003e\u003cbpmndi:BPMNShape bpmnElement=\"StartEvent_155asxm\" id=\"StartEvent_155asxm_di\"\u003e\u003comgdc:Bounds height=\"52\" width=\"199.65\" x=\"627\" y=\"14\"/\u003e\u003cbpmndi:BPMNLabel\u003e\u003comgdc:Bounds height=\"0\" width=\"90\" x=\"616\" y=\"100\"/\u003e\u003c/bpmndi:BPMNLabel\u003e\u003c/bpmndi:BPMNShape\u003e\u003cbpmndi:BPMNShape bpmnElement=\"ServiceTask_1\" id=\"ServiceTask_1_di\"\u003e\u003comgdc:Bounds height=\"84\" width=\"196\" x=\"629\" y=\"118\"/\u003e\u003c/bpmndi:BPMNShape\u003e\u003cbpmndi:BPMNShape bpmnElement=\"EndPoint_3\" id=\"EndPoint_3_di\"\u003e\u003comgdc:Bounds height=\"52\" width=\"132.15\" x=\"661\" y=\"424\"/\u003e\u003c/bpmndi:BPMNShape\u003e\u003cbpmndi:BPMNShape bpmnElement=\"ScriptTask_4\" id=\"ScriptTask_4_di\"\u003e\u003comgdc:Bounds height=\"84\" width=\"196\" x=\"629.3\" y=\"267.5\"/\u003e\u003c/bpmndi:BPMNShape\u003e\u003c/bpmndi:BPMNPlane\u003e\u003c/bpmndi:BPMNDiagram\u003e\u003c/definitions\u003e"
      },
