      "local_scripts": [
        {
          "actions": [],
          "created_date": 1710261846650,
          "description": "Write attachment creation results to a SOAR note.",
          "enabled": false,
          "export_key": "Axonius: Write attachment creation results to a note",
          "id": 31,
          "language": "python3",
          "last_modified_by": "admin@example.com",
          "last_modified_time": 1710264130785,
          "name": "Axonius: Write attachment creation results to a note",
          "object_type": "axonius_devices_dt",
          "playbook_handle": "axonius_write_device_json_to_an_attachment",
          "programmatic_name": "axonius_write_device_json_to_an_attachment_axonius_write_attachment_creation_results_to_a_note",
          "script_text": "results = playbook.functions.results.get_device_results\n\ninputs = results.get(\"inputs\", None)\naxonius_internal_axon_id = inputs.get(\"axonius_internal_axon_id\", None)\n\nif results.get(\"success\", False):\n  content = results.get(\"content\", None)\n  if content:\n    attachment_name = content.get(\"attachment_name\", None)\n    note_text = f\"\u003cb\u003eAxonius: Write Device JSON to Attachment:\u003c/b\u003e wrote attachment: \u003cb\u003e{attachment_name}\u003c/b\u003e.\"\n  else:\n    note_text = f\"\u003cb\u003eAxonius: Write Device JSON to Attachment:\u003c/b\u003e attachment was not written (no content) for {axonius_internal_axon_id}.\"\nelse:\n    reason = results.get(\"reason\", None)\n    note_text = f\"\u003cb\u003eAxonius: Write Device JSON to Attachment:\u003c/b\u003e attachment was not written {reason}\u003cbr\u003e for ID {axonius_internal_axon_id}.\"\n    \nincident.addNote(note_text)",
          "tags": [],
          "uuid": "bd87239d-b0bc-49b1-bcfa-62bcbc3ccea0"
        },
        {
          "actions": [],
          "created_date": 1710260801792,
          "description": "Write device JSON to a note.",
          "enabled": false,
          "export_key": "Axonius: Write device JSON to a note",
          "id": 30,
          "language": "python3",
          "last_modified_by": "admin@example.com",
          "last_modified_time": 1710260801792,
          "name": "Axonius: Write device JSON to a note",
          "object_type": "axonius_devices_dt",
          "playbook_handle": "axonius_write_device_json_to_an_attachment",
          "programmatic_name": "axonius_write_device_json_to_an_attachment_axonius_write_device_json_to_a_note",
          "script_text": "results = playbook.functions.results.get_device_results\ninputs = results.get(\"inputs\", None)\naxonius_internal_axon_id = inputs.get(\"axonius_internal_axon_id\", None)\n  \nheader = u\"\u003cb\u003eGet Device by ID:\u003c/b\u003e {0}\".format(axonius_internal_axon_id)\n\njson_note = {\n              \"version\": \"1.3\",\n              \"header\": header, \n              \"json\": results.content,\n              \"sort\": False\n            }\nplaybook.addProperty(\u0027convert_json_to_rich_text\u0027, json_note)",
          "tags": [],
          "uuid": "1eb346fd-a544-47c7-9269-606900b81dee"
        }
