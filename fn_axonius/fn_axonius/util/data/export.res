      "display_name": "Axonius: Add Artifacts to SOAR",
      "export_key": "axonius_add_artifacts_to_soar",
      "field_type_handle": "playbook_7137100b_450e_4c54_99d5_24efbefbb697",
      "fields_type": {
        "actions": [],
