      "output_json_example": "{\"version\": 2.0, \"success\": true, \"reason\": null, \"content\": {\"internal_axon_id\": \"aa25028476a106dff4659a467453b14a\", \"adapters\": [{\"accurate_for_datetime\": \"Wed, 06 Mar 2024 12:07:45 GMT\", \"client_used\": \"654389740e409055335e1a7c\", \"data\": {\"accurate_for_datetime\": \"Wed, 06 Mar 2024 12:07:45 GMT\", \"adapter_properties\": [\"Network\"], \"axon_id\": \"db09367aaa7d3442f42b34eee4689e53\", \"axonius_instance_name\": \"Primary\", \"color\": \"white\", \"correlates\": null, \"cp_type\": \"host\", \"external_nat_ip\": \"29.108.158.206\", \"fetch_time\": \"Wed, 06 Mar 2024 12:07:44 GMT\", \"first_fetch_time\": \"Thu, 02 Nov 2023 12:09:20 GMT\", \"from_last_fetch\": true, \"id\": \"84930807-1834-4d1b-8a09-8b35b2ed0eb6_DESKTOP-WilliamRandall\", \"is_latest_last_seen\": true, \"last_fetch_connection_id\": \"654389740e409055335e1a7c\", \"last_seen\": \"Tue, 05 Mar 2024 09:14:55 GMT\", \"lock\": \"unlocked\", \"name\": \"DESKTOP-WilliamRandall\", \"network_interfaces\": [{\"ips\": [\"10.0.49.121\"], \"ips_raw\": [167784825], \"ips_v4\": [\"10.0.49.121\"], \"ips_v4_raw\": [167784825]}], \"not_fetched_count\": 0, \"os\": {\"bitness\": 64, \"distribution\": \"XP\", \"is_windows_server\": false, \"os_str\": \"windows xp 64-bit\", \"type\": \"Windows\", \"type_distribution\": \"Windows XP\"}, \"pretty_id\": \"AX-343015\", \"raw\": {\"adapter_properties\": [\"Network\"], \"color\": \"white\", \"cp_type\": \"host\", \"external_nat_ip\": \"29.108.158.206\", \"firewall_rules\": [], \"id\": \"84930807-1834-4d1b-8a09-8b35b2ed0eb6_DESKTOP-WilliamRandall\", \"last_seen\": \"Tue, 05 Mar 2024 09:14:55 GMT\", \"lock\": \"unlocked\", \"name\": \"DESKTOP-WilliamRandall\", \"network_interfaces\": [{\"ips\": [\"10.0.49.121\"], \"ips_raw\": [167784825], \"ips_v4\": [\"10.0.49.121\"], \"ips_v4_raw\": [167784825]}], \"os\": {\"bitness\": 64, \"distribution\": \"XP\", \"is_windows_server\": false, \"os_str\": \"windows xp 64-bit\", \"type\": \"Windows\", \"type_distribution\": \"Windows XP\"}, \"read_only\": \"True\"}, \"read_only\": \"True\", \"scanner\": true, \"source_application\": \"Check Point Infinity\"}, \"plugin_name\": \"checkpoint_r80_adapter\", \"plugin_type\": \"Adapter\", \"plugin_unique_name\": \"checkpoint_r80_adapter_0\", \"quick_id\": \"checkpoint_r80_adapter_0!84930807-1834-4d1b-8a09-8b35b2ed0eb6_DESKTOP-WilliamRandall\", \"type\": \"entitydata\"}, {\"accurate_for_datetime\": \"Wed, 06 Mar 2024 14:59:55 GMT\", \"action_if_exists\": \"update\", \"associated_adapter_plugin_name\": \"checkpoint_r80_adapter\", \"associated_adapters\": [[\"checkpoint_r80_adapter_0\", \"84930807-1834-4d1b-8a09-8b35b2ed0eb6_DESKTOP-WilliamRandall\"], [\"claroty_adapter_0\", \"aa8c604d-55d7-47ff-8269-7ca0cd417a55DESKTOP-WilliamRandall\"], [\"google_mdm_adapter_0\", \"36478839-fd7d-4255-8452-d1f5264fd225\"], [\"cisco_meraki_adapter_0\", \"meraki-10.0.49.121\"], [\"cisco_adapter_0\", \"arp_88:53:2E:12:45:A9\"], [\"crowd_strike_adapter_0\", \"8101bfad-1a21-4bbd-85ea-417745710cdf\"], [\"service_now_adapter_0\", \"6d8fbf5e3caca7e894cbfcf7e8a7bbbf_DESKTOP-WilliamRandall\"], [\"tanium_adapter_0\", \"DESKTOP-WilliamRandall\"], [\"paloalto_panorama_adapter_0\", \"88:53:2E:12:45:A9\"], [\"epo_adapter_0\", \"epo_DESKTOP-WilliamRandall_948eff8d-3d9f-4482-a606-47fee1022573\"], [\"zoom_adapter_0\", \"13025ccd-26fe-4384-9751-1ccc75ad4480\"], [\"cylance_adapter_0\", \"2ee8e916-7a44-4d08-84e2-457ba7a0c9eeDESKTOP-WilliamRandall\"], [\"solarwinds_orion_adapter_0\", \"1129_DESKTOP-WilliamRandall\"], [\"sccm_adapter_0\", \"CN=DESKTOP-WilliamRandall,OU=Computers,DC=demo,DC=local\"], [\"tanium_asset_adapter_0\", \"D0D82833-A793-42F3-B5AB-8C7588130A89#_@DESKTOP-WilliamRandall\"], [\"tenable_security_center_adapter_0\", \"tenable_sc_DESKTOP-WilliamRandall_94d99b08-b5ac-4f30-90f8-0ac68cc90c83\"], [\"counter_act_adapter_0\", \"counter_act_b3c29e6b-25ea-4583-9b32-98f7777a3c6d\"]], \"association_type\": \"Tag\", \"data\": {\"cisa_vulnerabilities\": [{\"action\": \"Apply updates per vendor instructions.\", \"added\": \"Mon, 05 Dec 2022 00:00:00 GMT\", \"cve_id\": \"CVE-2022-4262\", \"desc\": \"Google Chromium V8 Engine contains a type confusion vulnerability that allows a remote attacker to potentially exploit heap corruption via a crafted HTML page. This vulnerability could affect multiple web browsers that utilize Chromium, including, but not limited to, Google Chrome, Microsoft Edge, and Opera.\", \"due_date\": \"Mon, 26 Dec 2022 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2022/12/stable-channel-update-for-desktop.html\", \"product\": \"Chromium V8\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium V8 Type Confusion Vulnerability\"}, {\"action\": \"Apply mitigations per vendor instructions or discontinue use of the product if mitigations are unavailable.\", \"added\": \"Wed, 17 Jan 2024 00:00:00 GMT\", \"cve_id\": \"CVE-2024-0519\", \"desc\": \"Google Chromium V8 Engine contains an out-of-bounds memory access vulnerability that allows a remote attacker to potentially exploit heap corruption via a crafted HTML page. This vulnerability could affect multiple web browsers that utilize Chromium, including, but not limited to, Google Chrome, Microsoft Edge, and Opera.\", \"due_date\": \"Wed, 07 Feb 2024 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2024/01/stable-channel-update-for-desktop_16.html\", \"product\": \"Chromium V8\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium V8 Out-of-Bounds Memory Access Vulnerability\"}, {\"action\": \"Apply mitigations per vendor instructions or discontinue use of the product if mitigations are unavailable.\", \"added\": \"Tue, 02 Jan 2024 00:00:00 GMT\", \"cve_id\": \"CVE-2023-7024\", \"desc\": \"Google Chromium WebRTC, an open-source project providing web browsers with real-time communication, contains a heap buffer overflow vulnerability that allows a remote attacker to potentially exploit heap corruption via a crafted HTML page. This vulnerability could impact web browsers using WebRTC, including but not limited to Google Chrome.\", \"due_date\": \"Tue, 23 Jan 2024 00:00:00 GMT\", \"notes\": \"This vulnerability affects a common open-source component, third-party library, or a protocol used by different products. Please check with specific vendors for information on patching status. For more information, please see: https://chromereleases.googleblog.com/2023/12/stable-channel-update-for-desktop_20.html\", \"product\": \"Chromium WebRTC\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium WebRTC Heap Buffer Overflow Vulnerability\"}, {\"action\": \"Apply updates per vendor instructions.\", \"added\": \"Fri, 28 Oct 2022 00:00:00 GMT\", \"cve_id\": \"CVE-2022-3723\", \"desc\": \"Google Chromium V8 Engine contains a type confusion vulnerability that allows a remote attacker to potentially exploit heap corruption via a crafted HTML page. This vulnerability could affect multiple web browsers that utilize Chromium, including, but not limited to, Google Chrome, Microsoft Edge, and Opera.\", \"due_date\": \"Fri, 18 Nov 2022 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2022/10/stable-channel-update-for-desktop_27.html\", \"product\": \"Chromium V8\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium V8 Type Confusion Vulnerability\"}, {\"action\": \"Apply mitigations per vendor instructions or discontinue use of the product if mitigations are unavailable.\", \"added\": \"Wed, 13 Sep 2023 00:00:00 GMT\", \"cve_id\": \"CVE-2023-4863\", \"desc\": \"Google Chromium WebP contains a heap-based buffer overflow vulnerability that allows a remote attacker to perform an out-of-bounds memory write via a crafted HTML page. This vulnerability can affect applications that use the WebP Codec.\", \"due_date\": \"Wed, 04 Oct 2023 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2023/09/stable-channel-update-for-desktop_11.html?m=1\", \"product\": \"Chromium WebP\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium WebP Heap-Based Buffer Overflow Vulnerability\"}, {\"action\": \"Apply updates per vendor instructions.\", \"added\": \"Thu, 30 Mar 2023 00:00:00 GMT\", \"cve_id\": \"CVE-2022-3038\", \"desc\": \"Google Chromium Network Service contains a use-after-free vulnerability that allows a remote attacker to potentially exploit heap corruption via a crafted HTML page. This vulnerability could affect multiple web browsers that utilize Chromium, including, but not limited to, Google Chrome, Microsoft Edge, and Opera.\", \"due_date\": \"Thu, 20 Apr 2023 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2022/08/stable-channel-update-for-desktop_30.html\", \"product\": \"Chromium Network Service\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium Network Service Use-After-Free Vulnerability\"}, {\"action\": \"Apply updates per vendor instructions.\", \"added\": \"Mon, 28 Nov 2022 00:00:00 GMT\", \"cve_id\": \"CVE-2022-4135\", \"desc\": \"Google Chromium GPU contains a heap buffer overflow vulnerability that allows a remote attacker, who has compromised the renderer process, to potentially perform a sandbox escape via a crafted HTML page. This vulnerability could affect multiple web browsers that utilize Chromium, including, but not limited to, Google Chrome, Microsoft Edge, and Opera.\", \"due_date\": \"Mon, 19 Dec 2022 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2022/11/stable-channel-update-for-desktop_24.html\", \"product\": \"Chromium GPU\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium GPU Heap Buffer Overflow Vulnerability\"}, {\"action\": \"Apply updates per vendor instructions.\", \"added\": \"Fri, 21 Apr 2023 00:00:00 GMT\", \"cve_id\": \"CVE-2023-2136\", \"desc\": \"Google Chromium Skia contains an integer overflow vulnerability that allows a remote attacker, who has compromised the renderer process, to potentially perform a sandbox escape via a crafted HTML page. This vulnerability affects Google Chrome and ChromeOS, Android, Flutter, and possibly other products.\", \"due_date\": \"Fri, 12 May 2023 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2023/04/stable-channel-update-for-desktop_18.html\", \"product\": \"Chromium Skia\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chrome Skia Integer Overflow Vulnerability\"}, {\"action\": \"Apply mitigations per vendor instructions or discontinue use of the product if mitigations are unavailable.\", \"added\": \"Thu, 30 Nov 2023 00:00:00 GMT\", \"cve_id\": \"CVE-2023-6345\", \"desc\": \"Google Chromium Skia contains an integer overflow vulnerability that allows a remote attacker, who has compromised the renderer process, to potentially perform a sandbox escape via a malicious file. This vulnerability affects Google Chrome and ChromeOS, Android, Flutter, and possibly other products.\", \"due_date\": \"Thu, 21 Dec 2023 00:00:00 GMT\", \"notes\": \"This vulnerability affects a common open-source component, third-party library, or a protocol used by different products. Please check with specific vendors for information on patching status. For more information, please see: https://chromereleases.googleblog.com/2023/11/stable-channel-update-for-desktop_28.html\", \"product\": \"Chromium Skia\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Skia Integer Overflow Vulnerability\"}, {\"action\": \"Apply mitigations per vendor instructions or discontinue use of the product if mitigations are unavailable.\", \"added\": \"Tue, 06 Feb 2024 00:00:00 GMT\", \"cve_id\": \"CVE-2023-4762\", \"desc\": \"Google Chromium V8 contains a type confusion vulnerability that allows a remote attacker to execute code via a crafted HTML page. This vulnerability could affect multiple web browsers that utilize Chromium, including, but not limited to, Google Chrome, Microsoft Edge, and Opera.\", \"due_date\": \"Tue, 27 Feb 2024 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2023/09/stable-channel-update-for-desktop.html\", \"product\": \"Chromium V8\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium V8 Type Confusion Vulnerability\"}, {\"action\": \"Apply updates per vendor instructions.\", \"added\": \"Mon, 17 Apr 2023 00:00:00 GMT\", \"cve_id\": \"CVE-2023-2033\", \"desc\": \"Google Chromium V8 Engine contains a type confusion vulnerability that allows a remote attacker to potentially exploit heap corruption via a crafted HTML page. This vulnerability could affect multiple web browsers that utilize Chromium, including, but not limited to, Google Chrome, Microsoft Edge, and Opera.\", \"due_date\": \"Mon, 08 May 2023 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2023/04/stable-channel-update-for-desktop_14.html\", \"product\": \"Chromium V8\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium V8 Type Confusion Vulnerability\"}, {\"action\": \"Apply updates per vendor instructions.\", \"added\": \"Wed, 07 Jun 2023 00:00:00 GMT\", \"cve_id\": \"CVE-2023-3079\", \"desc\": \"Google Chromium V8 Engine contains a type confusion vulnerability that allows a remote attacker to potentially exploit heap corruption via a crafted HTML page. This vulnerability could affect multiple web browsers that utilize Chromium, including, but not limited to, Google Chrome, Microsoft Edge, and Opera.\", \"due_date\": \"Wed, 28 Jun 2023 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2023/06/stable-channel-update-for-desktop.html\", \