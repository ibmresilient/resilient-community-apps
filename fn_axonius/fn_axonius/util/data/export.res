      "deployment_id": "playbook_2640021d_b7bb_4852_ae4c_931990bb3a42",
      "description": {
        "content": "Query Axonius using the user specified AQL query string or a saved query name in Axonius.  Optionally populate the devices returned in the Axonius Devices data table, write to a note or to an attachment.",
        "format": "text"
      },
