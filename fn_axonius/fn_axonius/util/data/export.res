84-9751-1ccc75ad4480\"], [\"cylance_adapter_0\", \"2ee8e916-7a44-4d08-84e2-457ba7a0c9eeDESKTOP-WilliamRandall\"], [\"solarwinds_orion_adapter_0\", \"1129_DESKTOP-WilliamRandall\"], [\"sccm_adapter_0\", \"CN=DESKTOP-WilliamRandall,OU=Computers,DC=demo,DC=local\"], [\"tanium_asset_adapter_0\", \"D0D82833-A793-42F3-B5AB-8C7588130A89#_@DESKTOP-WilliamRandall\"], [\"tenable_security_center_adapter_0\", \"tenable_sc_DESKTOP-WilliamRandall_94d99b08-b5ac-4f30-90f8-0ac68cc90c83\"], [\"counter_act_adapter_0\", \"counter_act_b3c29e6b-25ea-4583-9b32-98f7777a3c6d\"]], \"association_type\": \"Tag\", \"data\": {\"all_associated_email_addresses\": [\"maurice.stephenson@demo.local\", \"william.randall@demo.local\"], \"id\": \"static_analysis_0!cve!aa25028476a106dff4659a467453b14a\", \"last_used_users_ad_display_name_association\": [\"Maurice Stephenson\"], \"last_used_users_ad_user_principal_name_association\": [\"maurice.stephenson@demo.local\"], \"last_used_users_departments_association\": [\"Customer Success\", \"R\u0026D\"], \"last_used_users_email_domain_association\": [\"demo.local\"], \"last_used_users_internal_axon_id_association\": [\"69d352a8aa64318be82879f973ddd6d0\", \"c5626809a8193e409491f0c209e2ec37\"], \"last_used_users_mail_association\": [\"william.randall@demo.local\", \"maurice.stephenson@demo.local\"], \"last_used_users_user_manager_association\": [\"edythe.wright@demo.local\", \"terrance.burdette@demo.local\"], \"last_used_users_user_status_association\": [\"ACTIVE\"], \"last_used_users_user_title_association\": [\"Customer Success Engineer\", \"Senior R\u0026D Engineer\"], \"latest_used_user\": \"william.randall@demo.local\", \"latest_used_user_ad_display_name\": \"William Randall\", \"latest_used_user_department\": \"Customer Success\", \"latest_used_user_email_domain\": \"demo.local\", \"latest_used_user_mail\": \"william.randall@demo.local\", \"latest_used_user_user_manager\": \"edythe.wright@demo.local\", \"software_cves\": [{\"cve_description\": \"Heap buffer overflow in GPU in Google Chrome prior to 107.0.5304.121 allowed a remote attacker who had compromised the renderer process to potentially perform a sandbox escape via a crafted HTML page. (Chromium security severity: High)\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2022-4135\", \"cve_severity\": \"CRITICAL\", \"cvss\": 9.6, \"cvss3_score\": \"9.6\", \"cvss3_score_num\": 9.6, \"cvss_str\": \"CVSS 9.6\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"CWE-787\"], \"exploitability_score\": 2.8, \"impact_score\": 6.0, \"last_modified_date\": \"Thu, 15 Feb 2024 02:00:01 GMT\", \"publish_date\": \"Fri, 25 Nov 2022 01:15:09 GMT\", \"software_name\": \"microsoft edge\", \"software_vendor\": \"microsoft corporation\", \"software_version\": \"101.0.1210.53\", \"version_raw\": \"000000101000000000000121000000053\"}, {\"cve_description\": \"Heap buffer overflow in libwebp in Google Chrome prior to 116.0.5845.187 and libwebp 1.3.2 allowed a remote attacker to perform an out of bounds memory write via a crafted HTML page. (Chromium security severity: Critical)\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2023-4863\", \"cve_severity\": \"HIGH\", \"cvss\": 8.8, \"cvss3_score\": \"8.8\", \"cvss3_score_num\": 8.8, \"cvss_str\": \"CVSS 8.8\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"CWE-787\"], \"exploitability_score\": 2.8, \"impact_score\": 5.9, \"last_modified_date\": \"Sun, 07 Jan 2024 11:15:13 GMT\", \"publish_date\": \"Tue, 12 Sep 2023 15:15:24 GMT\", \"software_name\": \"microsoft edge\", \"software_vendor\": \"microsoft corporation\", \"software_version\": \"101.0.1210.53\", \"version_raw\": \"000000101000000000000121000000053\"}, {\"cve_description\": \"Rapid7 Insight Agent token handler versions 3.2.6 and below, suffer from a Directory Traversal vulnerability whereby unsanitized input from a CLI argument flows into io.ioutil.WriteFile, where it is used as a path. This can result in a Path Traversal vulnerability and allow an attacker to write arbitrary files. This issue is remediated in version 3.3.0 via safe guards that reject inputs that attempt to do path traversal.\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2023-2273\", \"cve_severity\": \"HIGH\", \"cvss\": 7.5, \"cvss3_score\": \"7.5\", \"cvss3_score_num\": 7.5, \"cvss_str\": \"CVSS 7.5\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"CWE-22\", \"CWE-22\"], \"exploitability_score\": 3.9, \"impact_score\": 3.6, \"last_modified_date\": \"Thu, 04 May 2023 17:52:05 GMT\", \"publish_date\": \"Wed, 26 Apr 2023 09:15:09 GMT\", \"software_name\": \"insight agent\", \"software_vendor\": \"rapid7, llc.\", \"software_version\": \"3.1.6.42\", \"version_raw\": \"000000003000000010000000600000042\"}, {\"cve_description\": \"Rapid7 Insight Agent token handler versions 3.2.6 and below, suffer from a Directory Traversal vulnerability whereby unsanitized input from a CLI argument flows into io.ioutil.WriteFile, where it is used as a path. This can result in a Path Traversal vulnerability and allow an attacker to write arbitrary files. This issue is remediated in version 3.3.0 via safe guards that reject inputs that attempt to do path traversal.\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2023-2273\", \"cve_severity\": \"HIGH\", \"cvss\": 7.5, \"cvss3_score\": \"7.5\", \"cvss3_score_num\": 7.5, \"cvss_str\": \"CVSS 7.5\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"CWE-22\", \"CWE-22\"], \"exploitability_score\": 3.9, \"impact_score\": 3.6, \"last_modified_date\": \"Thu, 04 May 2023 17:52:05 GMT\", \"publish_date\": \"Wed, 26 Apr 2023 09:15:09 GMT\", \"software_name\": \"insight agent\", \"software_vendor\": \"rapid7, llc.\", \"software_version\": \"3.1.6.44\", \"version_raw\": \"000000003000000010000000600000044\"}, {\"cve_description\": \"Rapid7 Insight Agent, versions prior to 3.1.3, suffer from an improper access control vulnerability whereby, the user has access to the snapshot directory. An attacker can access, read and copy any of the files in this directory e.g. asset_info.json or file_info.json, leading to a loss of confidentiality. This issue was fixed in Rapid7 Insight Agent 3.1.3.\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2021-4016\", \"cve_severity\": \"LOW\", \"cvss\": 3.3, \"cvss2_score\": \"2.1\", \"cvss2_score_num\": 2.1, \"cvss3_score\": \"3.3\", \"cvss3_score_num\": 3.3, \"cvss_str\": \"CVSS 3.3\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"NVD-CWE-Other\", \"CWE-284\"], \"exploitability_score\": 1.8, \"impact_score\": 1.4, \"last_modified_date\": \"Fri, 05 Aug 2022 11:09:58 GMT\", \"publish_date\": \"Fri, 21 Jan 2022 18:15:08 GMT\", \"software_name\": \"rapid7 insight agent\", \"software_vendor\": \"rapid7, inc.\", \"software_version\": \"3.0.4.1\", \"version_raw\": \"000000003000000000000000400000001\"}, {\"cve_description\": \"Rapid7 Insight Agent, versions 3.0.1 to 3.1.2.34, suffer from a local privilege escalation due to an uncontrolled DLL search path. Specifically, when Insight Agent versions 3.0.1 to 3.1.2.34 start, the Python interpreter attempts to load python3.dll at \\\"C:\\\\DLLs\\\\python3.dll,\\\" which normally is writable by locally authenticated users. Because of this, a malicious local user could use Insight Agent\u0027s startup conditions to elevate to SYSTEM privileges. This issue was fixed in Rapid7 Insight Agent 3.1.2.35. This vulnerability is a regression of CVE-2019-5629.\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2021-4007\", \"cve_severity\": \"HIGH\", \"cvss\": 7.8, \"cvss2_score\": \"7.2\", \"cvss2_score_num\": 7.2, \"cvss3_score\": \"7.8\", \"cvss3_score_num\": 7.8, \"cvss_str\": \"CVSS 7.8\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"CWE-427\", \"CWE-427\"], \"exploitability_score\": 1.8, \"impact_score\": 5.9, \"last_modified_date\": \"Tue, 21 Dec 2021 14:52:22 GMT\", \"publish_date\": \"Tue, 14 Dec 2021 15:15:07 GMT\", \"software_name\": \"rapid7 insight agent\", \"software_vendor\": \"rapid7, inc.\", \"software_version\": \"3.0.4.1\", \"version_raw\": \"000000003000000000000000400000001\"}, {\"cve_description\": \"Rapid7 Insight Agent versions 3.1.2.38 and earlier suffer from a privilege escalation vulnerability, whereby an attacker can hijack the flow of execution due to an unquoted argument to the runas.exe command used by the ir_agent.exe component, resulting in elevated rights and persistent access to the machine. This issue was fixed in Rapid7 Insight Agent version 3.1.3.80.\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2022-0237\", \"cve_severity\": \"HIGH\", \"cvss\": 7.8, \"cvss2_score\": \"7.2\", \"cvss2_score_num\": 7.2, \"cvss3_score\": \"7.8\", \"cvss3_score_num\": 7.8, \"cvss_str\": \"CVSS 7.8\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"CWE-428\", \"CWE-264\"], \"exploitability_score\": 1.8, \"impact_score\": 5.9, \"last_modified_date\": \"Thu, 24 Mar 2022 19:21:21 GMT\", \"publish_date\": \"Thu, 17 Mar 2022 23:15:07 GMT\", \"software_name\": \"rapid7 insight agent\", \"software_vendor\": \"rapid7, inc.\", \"software_version\": \"3.0.4.1\", \"version_raw\": \"000000003000000000000000400000001\"}, {\"cve_description\": \"Rapid7 Insight Agent token handler versions 3.2.6 and below, suffer from a Directory Traversal vulnerability whereby unsanitized input from a CLI argument flows into io.ioutil.WriteFile, where it is used as a path. This can result in a Path Traversal vulnerability and allow an attacker to write arbitrary files. This issue is remediated in version 3.3.0 via safe guards that reject inputs that attempt to do path traversal.\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2023-2273\", \"cve_severity\": \"HIGH\", \"cvss\": 7.5, \"cvss3_score\": \"7.5\", \"cvss3_score_num\": 7.5, \"cvss_str\": \"CVSS 7.5\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"CWE-22\", \"CWE-22\"], \"exploitability_score\": 3.9, \"impact_score\": 3.6, \"last_modified_date\": \"Thu, 04 May 2023 17:52:05 GMT\", \"publish_date\": \"Wed, 26 Apr 2023 09:15:09 GMT\", \"software_name\": \"rapid7 insight agent\", \"software_vendor\": \"rapid7, inc.\", \"software_version\": \"3.0.4.1\", \"version_raw\": \"000000003000000000000000400000001\"}, {\"cve_description\": \"The SSH transport protocol with certain OpenSSH extensions, found in OpenSSH before 9.6 and other products, allows remote attackers to bypass integrity checks such that some packets are omitted (from the extension negotiation message), and a client and server may consequently end up with a connection for which some security features have been downgraded or disabled, aka a Terrapin attack. This occurs because the SSH Binary Packet Protocol (BPP), implemented by these extensions, mishandles the handshake phase and mishandles use of sequence numbers. For example, there is an effective attack against SSH\u0027s use of ChaCha20-Poly1305 (and CBC with Encrypt-then-MAC). The bypass occurs in chacha20-poly1305@openssh.com and (if CBC is used) the -etm@openssh.com MAC algorithms. This also affects Maverick Synergy Java SSH API before 3.1.0-SNAPSHOT, Dropbear through 2022.83, Ssh before 5.1.1 in Erlang/OTP, PuTTY before 0.80, AsyncSSH before 2.14.2, golang.org/x/crypto before 0.17.0, libssh before 0.10.6, libssh2 through 1.11.0, Thorn Tech SFTP Gateway before 3.4.6, Tera Term before 5.1, Paramiko before 3.4.0, jsch before 0.2.15, SFTPGo before 2.5.6, Netgate pfSense Plus through 23.09.1, Netgate pfSense CE through 2.7.2, HPN-SSH through 18.2.0, ProFTPD before 1.3.8b (and before 1.3.9rc2), ORYX CycloneSSH before 2.3.4, NetSarang XShell 7 before Build 0144, CrushFTP before 10.6.0, ConnectBot SSH library before 2.2.22, Apache MINA sshd through 2.11.0, sshj through 0.37.0, TinySSH through 20230101, trilead-ssh2 6401, LANCOM LCOS and LANconfig, FileZilla before 3.66.4, Nova before 11.8, PKIX-SSH before 14.4, SecureCRT before 9.4.3, Transmit5 before 5.10.4, Win32-OpenSSH before 9.5.0.0p1-Beta, WinSCP before 6.2.2, Bitvise SSH Server before 9.32, Bitvise SSH Client before 9.33, KiTTY through 0.76.1.13, the net-ssh gem 7.2.0 for Ruby, the mscdex ssh2 module before 1.15.0 for Node.js, the thrussh library before 0.35.1 for Rust, and the Russh crate before 0.40.2 for Rust.\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2023-48795\", \"cve_severity\": \"MEDIUM\", \"cvss\": 5.9, \"cvss3_score\": \"5.9\", \"cvss3_score_num\": 5.9, \"cvss_str\": \"CVSS 5.9\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"CWE-354\"], \"exploitability_score\": 2.2, \"impact_score\": 3.6, \"last_modified_date\": \"Mon, 29 Jan 2024 09:15:42 GMT\", \"publish_date\": \"Mon, 18 Dec 2023 16:15:10 GMT\", \"software_name\": \"powershell\", \"software_vendor\": \"microsoft corporation\", \"software_version\": \"7.1.3.sha:.33ce13a0df94183fde13a07ddee0722a017a8d1\"}, {\"cve_description\": \".NET and Visual Studio Remote Code Execution Vulnerability\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2022-24512\", \"cve_severity\": \"MEDIUM\", \"cvss\": 6.3, \"cvss2_score\": \"6.8\", \"cvss2_score_num\": 6.8, \"cvss3_score\": \"6.3\", \"cvss3_score_num\": 6.3, \"cvss_str\": \"CVSS 6.3\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"NVD-CWE-noinfo\"], \"exploitability_score\": 2.8, \"impact_score\": 3.4, \"last_modified_date\": \"Thu, 21 Dec 2023 01:43:55 GMT\", \"publish_date\": \"Wed, 09 Mar 2022 17:15:15 GMT\", \"software_name\": \"powershell\", \"software_vendor\": \"microsoft corporation\", \"software_version\": \"7.1.3.sha:.33ce13a0df94183fde13a07ddee0722a017a8d1\"}, {\"cve_description\": \".NET Core and Visual Studio Information Disclosure Vulnerability\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2021-41355\", \"cve_severity\": \"MEDIUM\", \"cvss\": 5.7, \"cvss2_score\": \"2.9\", \"cvss2_score_num\": 2.9, \"cvss3_score\": \"5.7\", \"cvss3_score_num\": 5.7, \"cvss_str\": \"CVSS 5.7\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"NVD-CWE-noinfo\"], \"exploitability_score\": 2.1, \"impact_score\": 3.6, \"last_modified_date\": \"Tue, 01 Aug 2023 23:15:26 GMT\", \"publish_date\": \"Wed, 13 Oct 2021 01:15:13 GMT\", \"software_name\": \"powershell\", \"software_vendor\": \"microsoft corporation\", \"software_version\": \"7.1.3.sha:.33ce13a0df94183fde13a07ddee0722a017a8d1\"}, {\"cve_description\": \"PowerShell Elevation of Privilege Vulnerability\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2022-26788\", \"cve_severity\": \"HIGH\", \"cvss\": 7.8, \"cvss2_score\": \"4.6\", \"cvss2_score_num\": 4.6, \"cvss3_score\": \"7.8\", \"cvss3_score_num\": 7.8, \"cvss_str\": \"CVSS 7.8\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"NVD-CWE-noinfo\"], \"exploitability_score\": 1.8, \"impact_score\": 5.9, \"last_modified_date\": \"Thu, 29 Jun 2023 01:15:34 GMT\", \"publish_date\": \"Fri, 15 Apr 2022 19:15:12 GMT\", \"software_name\": \"powershell\", \"software_vendor\": \"microsoft corporation\", \"software_version\": \"7.1.3.sha:.33ce13a0df94183fde13a07ddee0722a017a8d1\"}, {\"cve_description\": \"A buffer overflow exists in the Brotli library versions prior to 1.0.8 where an attacker controlling the input length of a \\\"one-shot\\\" decompression request to a script can trigger a crash, which happens when copying over chunks of data larger than 2 GiB. It is recommended to update your Brotli library to 1.0.8 or later. If one cannot update, we recommend to use the \\\"streaming\\\" API as opposed to the \\\"one-shot\\\" API, and impose chunk size limits.\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2020-8927\", \"cve_severity\": \"MEDIUM\", \"cvss\": 6.5, \"cvss2_score\": \"6.4\", \"cvss2_score_num\": 6.4, \"cvss3_score\": \"6.5\", \"cvss3_score_num\": 6.5, \"cvss_str\": \"CVSS 6.5\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"CWE-120\", \"CWE-130\"], \"exploitability_score\": 3.9, \"impact_score\": 2.5, \"last_modified_date\": \"Tue, 07 Nov 2023 03:26:47 GMT\", \"publish_date\": \"Tue, 15 Sep 2020 10:15:12 GMT\", \"software_name\": \"powershell\", \"software_vendor\": \"microsoft corporation\", \"software_version\": \"7.1.3.sha:.33ce13a0df94183fde13a07ddee0722a017a8d1\"}, {\"cve_description\": \"\u003cp\u003eA security feature bypass vulnerability exists in Windows Defender Application Control (WDAC) which could allow an attacker to bypass WDAC enforcement. An attacker who successfully exploited this vulnerability could execute PowerShell commands that would be blocked by WDAC.\u003c/p\u003e\\n\u003cp\u003eTo exploit the vulnerability, an attacker need administrator access on a local machine where PowerShell is running. The attacker could then connect to a PowerShell session and send commands to execute arbitrary code.\u003c/p\u003e\\n\u003cp\u003eThe update addresses the vulnerability by correcting how PowerShell commands are validated when WDAC protection is enabled.\u003c/p\u003e\\n\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2020-0951\", \"cve_severity\": \"MEDIUM\", \"cvss\": 6.7, \"cvss2_score\": \"7.2\", \"cvss2_score_num\": 7.2, \"cvss3_score\": \"6.7\", \"cvss3_score_num\": 6.7, \"cvss_str\": \"CVSS 6.7\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"NVD-CWE-noinfo\"], \"exploitability_score\": 0.8, \"impact_score\": 5.9, \"last_modified_date\": \"Sun, 31 Dec 2023 22:15:48 GMT\", \"publish_date\": \"Fri, 11 Sep 2020 17:15:15 GMT\", \"software_name\": \"powershell\", \"software_vendor\": \"microsoft corporation\", \"software_version\": \"7.1.3.sha:.33ce13a0df94183fde13a07ddee0722a017a8d1\"}, {\"cve_description\": \"Rapid7 Insight Agent token handler versions 3.2.6 and below, suffer from a Directory Traversal vulnerability whereby unsanitized input from a CLI argument flows into io.ioutil.WriteFile, where it is used as a path. This can result in a Path Traversal vulnerability and allow an attacker to write arbitrary files. This issue is remediated in version 3.3.0 via safe guards that reject inputs that attempt to do path traversal.\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2023-2273\", \"cve_severity\": \"HIGH\", \"cvss\": 7.5, \"cvss3_score\": \"7.5\", \"cvss3_score_num\": 7.5, \"cvss_str\": \"CVSS 7.5\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"CWE-22\", \"CWE-22\"], \"exploitability_score\": 3.9, \"impact_score\": 3.6, \"last_modified_date\": \"Thu, 04 May 2023 17:52:05 GMT\", \"publish_date\": \"Wed, 26 Apr 2023 09:15:09 GMT\", \"software_name\": \"rapid7 insight agent\", \"software_vendor\": \"rapid7\", \"software_version\": \"3.1.6.44\", \"version_raw\": \"000000003000000010000000600000044\"}, {\"cve_description\": \"A remote code execution vulnerability was identified in GitHub Enterprise Server that could be exploited when building a GitHub Pages site. User-controlled configuration of the underlying parsers used by GitHub Pages were not sufficiently restricted and made it possible to execute commands on the GitHub Enterprise Server instance. To exploit this vulnerability, an attacker would need permission to create and build a GitHub Pages site on the GitHub Enterprise Server instance. This vulnerability affected all versions of GitHub Enterprise Server prior to 2.22 and was fixed in 2.21.6, 2.20.15, and 2.19.21. The underlying issues contributing to this vulnerability were identified both internally and through the GitHub Security Bug Bounty program.\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2020-10518\", \"cve_severity\": \"HIGH\", \"cvss\": 8.8, \"cvss2_score\": \"6.5\", \"cvss2_score_num\": 6.5, \"cvss3_score\": \"8.8\", \"cvss3_score_num\": 8.8, \"cvss_str\": \"CVSS 8.8\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"NVD-CWE-noinfo\", \"CWE-77\"], \"exploitability_score\": 2.8, \"impact_score\": 5.9, \"last_modified_date\": \"Mon, 20 Dec 2021 22:35:23 GMT\", \"publish_date\": \"Thu, 27 Aug 2020 22:15:09 GMT\", \"software_name\": \"github.ui\", \"software_vendor\": \"github.ui\", \"software_version\": \"2.0.394.beta+3fc6791abf\"}, {\"cve_description\": \"An improper access control vulnerability was identified in GitHub Enterprise Server that allowed authenticated users of the instance to determine the names of unauthorized private repositories given their numerical IDs. This vulnerability did not allow unauthorized access to any repository content besides the name. This vulnerability affected all versions of GitHub Enterprise Server prior to 2.22 and was fixed in versions 2.21.6, 2.20.15, and 2.19.21. This vulnerability was reported via the GitHub Bug Bounty program.\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2020-10517\", \"cve_severity\": \"MEDIUM\", \"cvss\": 4.3, \"cvss2_score\": \"4.0\", \"cvss2_score_num\": 4.0, \"cvss3_score\": \"4.3\", \"cvss3_score_num\": 4.3, \"cvss_str\": \"CVSS 4.3\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"NVD-CWE-noinfo\", \"CWE-285\"], \"exploitability_score\": 2.8, \"impact_score\": 1.4, \"last_modified_date\": \"Thu, 07 Oct 2021 17:07:22 GMT\", \"publish_date\": \"Thu, 27 Aug 2020 22:15:09 GMT\", \"software_name\": \"github.ui\", \"software_vendor\": \"github.ui\", \"software_version\": \"2.0.394.beta+3fc6791abf\"}, {\"cve_description\": \"A remote code execution vulnerability was identified in GitHub Enterprise Server that could be exploited when building a GitHub Pages site. User-controlled configuration of the underlying parsers used by GitHub Pages were not sufficiently restricted and made it possible to execute commands on the GitHub Enterprise Server instance. To exploit this vulnerability, an attacker would need permission to create and build a GitHub Pages site on the GitHub Enterprise Server instance. This vulnerability affected all versions of GitHub Enterprise Server prior to 2.22.7 and was fixed in 2.22.7, 2.21.15, and 2.20.24. The underlying issues contributing to this vulnerability were identified through the GitHub Security Bug Bounty program.\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2020-10519\", \"cve_severity\": \"HIGH\", \"cvss\": 8.8, \"cvss2_score\": \"6.5\", \"cvss2_score_num\": 6.5, \"cvss3_score\": \"8.8\", \"cvss3_score_num\": 8.8, \"cvss_str\": \"CVSS 8.8\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"NVD-CWE-noinfo\", \"CWE-77\"], \"exploitability_score\": 2.8, \"impact_score\": 5.9, \"last_modified_date\": \"Tue, 07 Nov 2023 03:14:10 GMT\", \"publish_date\": \"Wed, 03 Mar 2021 04:15:12 GMT\", \"software_name\": \"github.ui\", \"software_vendor\": \"github.ui\", \"software_version\": \"2.0.394.beta+3fc6791abf\"}, {\"cve_description\": \"GitHub Enterprise before 20120304 does not properly restrict the use of a hash to provide values for a model\u0027s attributes, which allows remote attackers to set the public_key[user_id] value via a modified URL for the public-key update form, related to a \\\"mass assignment\\\" vulnerability.\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2012-2055\", \"cve_severity\": \"HIGH\", \"cvss\": 7.5, \"cvss2_score\": \"5.0\", \"cvss2_score_num\": 5.0, \"cvss3_score\": \"7.5\", \"cvss3_score_num\": 7.5, \"cvss_str\": \"CVSS 7.5\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"CWE-913\"], \"exploitability_score\": 3.9, \"impact_score\": 3.6, \"last_modified_date\": \"Sun, 21 Jan 2024 02:39:05 GMT\", \"publish_date\": \"Thu, 05 Apr 2012 14:55:06 GMT\", \"software_name\": \"github.ui\", \"software_vendor\": \"github.ui\", \"software_version\": \"2.0.394.beta+3fc6791abf\"}, {\"cve_description\": \"Rapid7 Insight Agent token handler versions 3.2.6 and below, suffer from a Directory Traversal vulnerability whereby unsanitized input from a CLI argument flows into io.ioutil.WriteFile, where it is used as a path. This can result in a Path Traversal vulnerability and allow an attacker to write arbitrary files. This issue is remediated in version 3.3.0 via safe guards that reject inputs that attempt to do path traversal.\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2023-2273\", \"cve_severity\": \"HIGH\", \"cvss\": 7.5, \"cvss3_score\": \"7.5\", \"cvss3_score_num\": 7.5, \"cvss_str\": \"CVSS 7.5\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"CWE-22\", \"CWE-22\"], \"exploitability_score\": 3.9, \"impact_score\": 3.6, \"last_modified_date\": \"Thu, 04 May 2023 17:52:05 GMT\", \"publish_date\": \"Wed, 26 Apr 2023 09:15:09 GMT\", \"software_name\": \"insight agent\", \"software_vendor\": \"rapid7, llc.\", \"software_version\": \"3.1.6.44\", \"version_raw\": \"000000003000000010000000600000044\"}, {\"cve_description\": \"Heap buffer overflow in libwebp in Google Chrome prior to 116.0.5845.187 and libwebp 1.3.2 allowed a remote attacker to perform an out of bounds memory write via a crafted HTML page. (Chromium security severity: Critical)\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2023-4863\", \"cve_severity\": \"HIGH\", \"cvss\": 8.8, \"cvss3_score\": \"8.8\", \"cvss3_score_num\": 8.8, \"cvss_str\": \"CVSS 8.8\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"CWE-787\"], \"exploitability_score\": 2.8, \"impact_score\": 5.9, \"last_modified_date\": \"Sun, 07 Jan 2024 11:15:13 GMT\", \"publish_date\": \"Tue, 12 Sep 2023 15:15:24 GMT\", \"software_name\": \"microsoft edge\", \"software_vendor\": \"microsoft corporation\", \"software_version\": \"103.0.1264.77\", \"version_raw\": \"000000103000000000000126400000077\"}, {\"cve_description\": \"Heap buffer overflow in GPU in Google Chrome prior to 107.0.5304.121 allowed a remote attacker who had compromised the renderer process to potentially perform a sandbox escape via a crafted HTML page. (Chromium security severity: High)\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2022-4135\", \"cve_severity\": \"CRITICAL\", \"cvss\": 9.6, \"cvss3_score\": \"9.6\", \"cvss3_score_num\": 9.6, \"cvss_str\": \"CVSS 9.6\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"CWE-787\"], \"exploitability_score\": 2.8, \"impact_score\": 6.0, \"last_modified_date\": \"Thu, 15 Feb 2024 02:00:01 GMT\", \"publish_date\": \"Fri, 25 Nov 2022 01:15:09 GMT\", \"software_name\": \"microsoft edge\", \"software_vendor\": \"microsoft corporation\", \"software_version\": \"103.0.1264.77\", \"version_raw\": \"000000103000000000000126400000077\"}, {\"cve_description\": \"Heap buffer overflow in GPU in Google Chrome prior to 107.0.5304.121 allowed a remote attacker who had compromised the renderer process to potentially perform a sandbox escape via a crafted HTML page. (Chromium security severity: High)\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2022-4135\", \"cve_severity\": \"CRITICAL\", \"cvss\": 9.6, \"cvss3_score\": \"9.6\", \"cvss3_score_num\": 9.6, \"cvss_str\": \"CVSS 9.6\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"CWE-787\"], \"exploitability_score\": 2.8, \"impact_score\": 6.0, \"last_modified_date\": \"Thu, 15 Feb 2024 02:00:01 GMT\", \"publish_date\": \"Fri, 25 Nov 2022 01:15:09 GMT\", \"software_name\": \"microsoft edge\", \"software_vendor\": \"microsoft corporation\", \"software_version\": \"101.0.1210.53\", \"version_raw\": \"000000101000000000000121000000053\"}, {\"cve_description\": \"Heap buffer overflow in libwebp in Google Chrome prior to 116.0.5845.187 and libwebp 1.3.2 allowed a remote attacker to perform an out of bounds memory write via a crafted HTML page. (Chromium security severity: Critical)\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2023-4863\", \"cve_severity\": \"HIGH\", \"cvss\": 8.8, \"cvss3_score\": \"8.8\", \"cvss3_score_num\": 8.8, \"cvss_str\": \"CVSS 8.8\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"CWE-787\"], \"exploitability_score\": 2.8, \"impact_score\": 5.9, \"last_modified_date\": \"Sun, 07 Jan 2024 11:15:13 GMT\", \"publish_date\": \"Tue, 12 Sep 2023 15:15:24 GMT\", \"software_name\": \"microsoft edge\", \"software_vendor\": \"microsoft corporation\", \"software_version\": \"101.0.1210.53\", \"version_raw\": \"000000101000000000000121000000053\"}, {\"cve_description\": \"A remote code execution vulnerability was identified in GitHub Enterprise Server that could be exploited when building a GitHub Pages site. User-controlled configuration of the underlying parsers used by GitHub Pages were not sufficiently restricted and made it possible to execute commands on the GitHub Enterprise Server instance. To exploit this vulnerability, an attacker would need permission to create and build a GitHub Pages site on the GitHub Enterprise Server instance. This vulnerability affected all versions of GitHub Enterprise Server prior to 2.22 and was fixed in 2.21.6, 2.20.15, and 2.19.21. The underlying issues contributing to this vulnerability were identified both internally and through the GitHub Security Bug Bounty program.\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2020-10518\", \"cve_severity\": \"HIGH\", \"cvss\": 8.8, \"cvss2_score\": \"6.5\", \"cvss2_score_num\": 6.5, \"cvss3_score\": \"8.8\", \"cvss3_score_num\": 8.8, \"cvss_str\": \"CVSS 8.8\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"NVD-CWE-noinfo\", \"CWE-77\"], \"exploitability_score\": 2.8, \"impact_score\": 5.9, \"last_modified_date\": \"Mon, 20 Dec 2021 22:35:23 GMT\", \"publish_date\": \"Thu, 27 Aug 2020 22:15:09 GMT\", \"software_name\": \"github.ui\", \"software_vendor\": \"github.ui\", \"software_version\": \"2.0.452+b00c5acad3\", \"version_raw\": \"0000000020000000000000452\"}, {\"cve_description\": \"An improper access control vulnerability was identified in GitHub Enterprise Server that allowed authenticated users of the instance to determine the names of unauthorized private repositories given their numerical IDs. This vulnerability did not allow unauthorized access to any repository content besides the name. This vulnerability affected all versions of GitHub Enterprise Server prior to 2.22 and was fixed in versions 2.21.6, 2.20.15, and 2.19.21. This vulnerability was reported via the GitHub Bug Bounty program.\", \"cve_from_sw_analysis\": true, \"cve_id\": \"CVE-2020-10517\", \"cve_severity\": \"MEDIUM\", \"cvss\": 4.3, \"cvss2_score\": \"4.0\", \"cvss2_score_num\": 4.0, \"cvss3_score\": \"4.3\", \"cvss3_score_num\": 4.3, \"cvss_str\": \"CVSS 4.3\", \"cvss_version\": \"v3.0\", \"cwe_id\": [\"NVD-CWE-noinfo\", \"CWE-285\"], \"exploitability_score\": 2.8, \"impact_score\": 1.4, \"last_modified_date\":