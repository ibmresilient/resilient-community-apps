data.software_cves\", \"title\": \"Vulnerable Software\", \"type\": \"array\"}}, {\"data\": [{\"action\": \"For all affected software assets for which updates exist, the only acceptable remediation actions are: 1) Apply updates; OR 2) remove affected assets from agency networks. Temporary mitigations using one of the measures provided at https://www.cisa.gov/uscert/ed-22-02-apache-log4j-recommended-mitigation-measures are only acceptable until updates are available.\", \"adapters\": [\"cisa_enrichment\"], \"added\": \"Fri, 10 Dec 2021 00:00:00 GMT\", \"cve_id\": \"CVE-2021-44228\", \"desc\": \"Apache Log4j2 contains a vulnerability where JNDI features do not protect against attacker-controlled JNDI-related endpoints, allowing for remote code execution.\", \"due_date\": \"Fri, 24 Dec 2021 00:00:00 GMT\", \"product\": \"Log4j2\", \"used_in_ransomware\": true, \"vendor\": \"Apache\", \"vulnerability_name\": \"Apache Log4j2 Remote Code Execution Vulnerability\"}, {\"action\": \"Apply updates per vendor instructions.\", \"adapters\": [\"cisa_enrichment\"], \"added\": \"Thu, 30 Mar 2023 00:00:00 GMT\", \"cve_id\": \"CVE-2022-3038\", \"desc\": \"Google Chromium Network Service contains a use-after-free vulnerability that allows a remote attacker to potentially exploit heap corruption via a crafted HTML page. This vulnerability could affect multiple web browsers that utilize Chromium, including, but not limited to, Google Chrome, Microsoft Edge, and Opera.\", \"due_date\": \"Thu, 20 Apr 2023 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2022/08/stable-channel-update-for-desktop_30.html\", \"product\": \"Chromium Network Service\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium Network Service Use-After-Free Vulnerability\"}, {\"action\": \"Apply updates per vendor instructions.\", \"adapters\": [\"cisa_enrichment\"], \"added\": \"Thu, 08 Sep 2022 00:00:00 GMT\", \"cve_id\": \"CVE-2022-3075\", \"desc\": \"Google Chromium Mojo contains an insufficient data validation vulnerability that allows a remote attacker, who has compromised the renderer process, to potentially perform a sandbox escape via a crafted HTML page. This vulnerability could affect multiple web browsers that utilize Chromium, including, but not limited to, Google Chrome, Microsoft Edge, and Opera.\", \"due_date\": \"Thu, 29 Sep 2022 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2022/09/stable-channel-update-for-desktop.html, https://msrc.microsoft.com/update-guide/vulnerability/CVE-2022-3075\", \"product\": \"Chromium Mojo\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium Mojo Insufficient Data Validation Vulnerability\"}, {\"action\": \"Apply updates per vendor instructions.\", \"adapters\": [\"cisa_enrichment\"], \"added\": \"Fri, 28 Oct 2022 00:00:00 GMT\", \"cve_id\": \"CVE-2022-3723\", \"desc\": \"Google Chromium V8 Engine contains a type confusion vulnerability that allows a remote attacker to potentially exploit heap corruption via a crafted HTML page. This vulnerability could affect multiple web browsers that utilize Chromium, including, but not limited to, Google Chrome, Microsoft Edge, and Opera.\", \"due_date\": \"Fri, 18 Nov 2022 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2022/10/stable-channel-update-for-desktop_27.html\", \"product\": \"Chromium V8\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium V8 Type Confusion Vulnerability\"}, {\"action\": \"Apply updates per vendor instructions.\", \"adapters\": [\"cisa_enrichment\"], \"added\": \"Mon, 28 Nov 2022 00:00:00 GMT\", \"cve_id\": \"CVE-2022-4135\", \"desc\": \"Google Chromium GPU contains a heap buffer overflow vulnerability that allows a remote attacker, who has compromised the renderer process, to potentially perform a sandbox escape via a crafted HTML page. This vulnerability could affect multiple web browsers that utilize Chromium, including, but not limited to, Google Chrome, Microsoft Edge, and Opera.\", \"due_date\": \"Mon, 19 Dec 2022 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2022/11/stable-channel-update-for-desktop_24.html\", \"product\": \"Chromium GPU\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium GPU Heap Buffer Overflow Vulnerability\"}, {\"action\": \"Apply updates per vendor instructions.\", \"adapters\": [\"cisa_enrichment\"], \"added\": \"Mon, 05 Dec 2022 00:00:00 GMT\", \"cve_id\": \"CVE-2022-4262\", \"desc\": \"Google Chromium V8 Engine contains a type confusion vulnerability that allows a remote attacker to potentially exploit heap corruption via a crafted HTML page. This vulnerability could affect multiple web browsers that utilize Chromium, including, but not limited to, Google Chrome, Microsoft Edge, and Opera.\", \"due_date\": \"Mon, 26 Dec 2022 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2022/12/stable-channel-update-for-desktop.html\", \"product\": \"Chromium V8\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium V8 Type Confusion Vulnerability\"}, {\"action\": \"Apply updates per vendor instructions.\", \"adapters\": [\"cisa_enrichment\"], \"added\": \"Mon, 17 Apr 2023 00:00:00 GMT\", \"cve_id\": \"CVE-2023-2033\", \"desc\": \"Google Chromium V8 Engine contains a type confusion vulnerability that allows a remote attacker to potentially exploit heap corruption via a crafted HTML page. This vulnerability could affect multiple web browsers that utilize Chromium, including, but not limited to, Google Chrome, Microsoft Edge, and Opera.\", \"due_date\": \"Mon, 08 May 2023 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2023/04/stable-channel-update-for-desktop_14.html\", \"product\": \"Chromium V8\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium V8 Type Confusion Vulnerability\"}, {\"action\": \"Apply updates per vendor instructions.\", \"adapters\": [\"cisa_enrichment\"], \"added\": \"Fri, 21 Apr 2023 00:00:00 GMT\", \"cve_id\": \"CVE-2023-2136\", \"desc\": \"Google Chromium Skia contains an integer overflow vulnerability that allows a remote attacker, who has compromised the renderer process, to potentially perform a sandbox escape via a crafted HTML page. This vulnerability affects Google Chrome and ChromeOS, Android, Flutter, and possibly other products.\", \"due_date\": \"Fri, 12 May 2023 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2023/04/stable-channel-update-for-desktop_18.html\", \"product\": \"Chromium Skia\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chrome Skia Integer Overflow Vulnerability\"}, {\"action\": \"Apply updates per vendor instructions.\", \"adapters\": [\"cisa_enrichment\"], \"added\": \"Wed, 07 Jun 2023 00:00:00 GMT\", \"cve_id\": \"CVE-2023-3079\", \"desc\": \"Google Chromium V8 Engine contains a type confusion vulnerability that allows a remote attacker to potentially exploit heap corruption via a crafted HTML page. This vulnerability could affect multiple web browsers that utilize Chromium, including, but not limited to, Google Chrome, Microsoft Edge, and Opera.\", \"due_date\": \"Wed, 28 Jun 2023 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2023/06/stable-channel-update-for-desktop.html\", \"product\": \"Chromium V8\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium V8 Type Confusion Vulnerability\"}, {\"action\": \"Apply mitigations per vendor instructions or discontinue use of the product if mitigations are unavailable.\", \"adapters\": [\"cisa_enrichment\"], \"added\": \"Tue, 06 Feb 2024 00:00:00 GMT\", \"cve_id\": \"CVE-2023-4762\", \"desc\": \"Google Chromium V8 contains a type confusion vulnerability that 