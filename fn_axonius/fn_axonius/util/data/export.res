      },
      "last_modified_time": 1711135091135,
      "local_scripts": [
        {
          "actions": [],
          "created_date": 1710444243790,
          "description": "Create artifacts from Axonius Devices data table row",
          "enabled": false,
          "export_key": "Axonius: Create artifacts from data table row",
          "id": 33,
          "language": "python3",
          "last_modified_by": "admin@example.com",
          "last_modified_time": 1711135089016,
          "name": "Axonius: Create artifacts from data table row",
          "object_type": "axonius_devices_dt",
          "playbook_handle": "axonius_add_artifacts_to_soar",
          "programmatic_name": "axonius_add_artifacts_to_soar_axonius_create_artifacts_from_data_table_row",
          "script_text": "count = 0\n\nif row.axonius_ip:\n  ip_list = row.axonius_ip.split(\", \")\n  for ip in ip_list:\n    incident.addArtifact(\"IP Address\", ip, \"Artifact created from Axonius device asset name:{0} device ID: {1}\".format(row.axonius_name, row.axonius_id))\n    count += 1\n    \nif row.axonius_hostname:\n  incident.addArtifact(\"System Name\", row.axonius_hostname, \"Artifact created from Axonius device asset name: {0} device ID: {1}\".format(row.axonius_name, row.axonius_id))\n  count += 1\n  \nif row.axonius_os_type_distribution:\n  incident.addArtifact(\"Service\", row.axonius_os_type_distribution, \"Artifact created from Axonius device asset name: {0} device ID: {1}\".format(row.axonius_name, row.axonius_id))\n  count += 1\n  \nincident.addNote(f\"\u003cb\u003eAxonius: Create Artifacts in SOAR\u003c/b\u003e added \u003cb\u003e{count}\u003c/b\u003e artifacts.\")",
          "tags": [],
          "uuid": "2007a897-13d6-492e-b720-9d850669f9b3"
        }
      ],
      "manual_settings": {
        "activation_conditions": {
          "conditions": [],
          "logic_type": "all"
        },
        "view_items": []
      },
      "name": "axonius_add_artifacts_to_soar",
