"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium V8 Out-of-Bounds Memory Access Vulnerability\"}, {\"action\": \"Apply mitigations per vendor instructions or discontinue use of the product if mitigations are unavailable.\", \"added\": \"Tue, 02 Jan 2024 00:00:00 GMT\", \"cve_id\": \"CVE-2023-7024\", \"desc\": \"Google Chromium WebRTC, an open-source project providing web browsers with real-time communication, contains a heap buffer overflow vulnerability that allows a remote attacker to potentially exploit heap corruption via a crafted HTML page. This vulnerability could impact web browsers using WebRTC, including but not limited to Google Chrome.\", \"due_date\": \"Tue, 23 Jan 2024 00:00:00 GMT\", \"notes\": \"This vulnerability affects a common open-source component, third-party library, or a protocol used by different products. Please check with specific vendors for information on patching status. For more information, please see: https://chromereleases.googleblog.com/2023/12/stable-channel-update-for-desktop_20.html\", \"product\": \"Chromium WebRTC\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium WebRTC Heap Buffer Overflow Vulnerability\"}, {\"action\": \"Apply updates per vendor instructions.\", \"added\": \"Fri, 28 Oct 2022 00:00:00 GMT\", \"cve_id\": \"CVE-2022-3723\", \"desc\": \"Google Chromium V8 Engine contains a type confusion vulnerability that allows a remote attacker to potentially exploit heap corruption via a crafted HTML page. This vulnerability could affect multiple web browsers that utilize Chromium, including, but not limited to, Google Chrome, Microsoft Edge, and Opera.\", \"due_date\": \"Fri, 18 Nov 2022 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2022/10/stable-channel-update-for-desktop_27.html\", \"product\": \"Chromium V8\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium V8 Type Confusion Vulnerability\"}, {\"action\": \"Apply mitigations per vendor instructions or discontinue use of the product if mitigations are unavailable.\", \"added\": \"Wed, 13 Sep 2023 00:00:00 GMT\", \"cve_id\": \"CVE-2023-4863\", \"desc\": \"Google Chromium WebP contains a heap-based buffer overflow vulnerability that allows a remote attacker to perform an out-of-bounds memory write via a crafted HTML page. This vulnerability can affect applications that use the WebP Codec.\", \"due_date\": \"Wed, 04 Oct 2023 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2023/09/stable-channel-update-for-desktop_11.html?m=1\", \"product\": \"Chromium WebP\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium WebP Heap-Based Buffer Overflow Vulnerability\"}, {\"action\": \"Apply updates per vendor instructions.\", \"added\": \"Thu, 30 Mar 2023 00:00:00 GMT\", \"cve_id\": \"CVE-2022-3038\", \"desc\": \"Google Chromium Network Service contains a use-after-free vulnerability that allows a remote attacker to potentially exploit heap corruption via a crafted HTML page. This vulnerability could affect multiple web browsers that utilize Chromium, including, but not limited to, Google Chrome, Microsoft Edge, and Opera.\", \"due_date\": \"Thu, 20 Apr 2023 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2022/08/stable-channel-update-for-desktop_30.html\", \"product\": \"Chromium Network Service\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium Network Service Use-After-Free Vulnerability\"}, {\"action\": \"Apply updates per vendor instructions.\", \"added\": \"Mon, 28 Nov 2022 00:00:00 GMT\", \"cve_id\": \"CVE-2022-4135\", \"desc\": \"Google Chromium GPU contains a heap buffer overflow vulnerability that allows a remote attacker, who has compromised the renderer process, to potentially perform a sandbox escape via a crafted HTML page. This vulnerability could affect multiple web browsers that utilize Chromium, including, but not limited to, Google Chrome, Microsoft Edge, and Opera.\", \"due_date\": \"Mon, 19 Dec 2022 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2022/11/stable-channel-update-for-desktop_24.html\", \"product\": \"Chromium GPU\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chromium GPU Heap Buffer Overflow Vulnerability\"}, {\"action\": \"Apply updates per vendor instructions.\", \"added\": \"Fri, 21 Apr 2023 00:00:00 GMT\", \"cve_id\": \"CVE-2023-2136\", \"desc\": \"Google Chromium Skia contains an integer overflow vulnerability that allows a remote attacker, who has compromised the renderer process, to potentially perform a sandbox escape via a crafted HTML page. This vulnerability affects Google Chrome and ChromeOS, Android, Flutter, and possibly other products.\", \"due_date\": \"Fri, 12 May 2023 00:00:00 GMT\", \"notes\": \"https://chromereleases.googleblog.com/2023/04/stable-channel-update-for-desktop_18.html\", \"product\": \"Chromium Skia\", \"used_in_ransomware\": false, \"vendor\": \"Google\", \"vulnerability_name\": \"Google Chrome Skia Integer Overflow Vulnerability\"}, {\"action\": \"Apply mitigations per vendor instructions or discontinue use of the product if mitigations are unavailable.\", \"added\": \"Thu, 30 Nov 2023 00:00:00 GMT\", \"cve_id\": \"CVE-2023-6345\", \"desc\": \"Google Chromium Skia contains an integer overflow vulnerability that allows a remote attacker, who has compromised the renderer process, to potentially perform a sandbox escape via a malicious file. This vulnerability affects Google Chrome and ChromeOS, Android, Flutter, and possibly other products.\", \"due_date\": \"Thu, 21 Dec 2023 00:00:00 GMT\", \"notes\": \"This vulnerability affects a common open-source component, third-party library, or a protocol used by different products. Please check with specific vendors for information on patching status. For more information,